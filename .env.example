# ---------------------------------------------------------------------------
# ANICA Wellness Spa — Business Operating System
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon / Supabase / Railway / local)
DATABASE_URL="postgresql://anica:anica@127.0.0.1:5432/anica?schema=public"

# 32+ char random string used to sign session JWTs.
#   openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public base URL of the deployment (used for PayMongo redirects & emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- PayMongo (online booking reservation fee) ------------------------------
# Test keys start with pk_test_ / sk_test_. Live keys with pk_live_ / sk_live_.
# Leave blank to run the booking flow in SIMULATED gateway mode (dev only).
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# --- Transactional email ----------------------------------------------------
# Leave RESEND_API_KEY blank to log emails to the console instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="ANICA Wellness Spa <bookings@example.com>"

# --- Optional SMS gateway (Semaphore, PH) -----------------------------------
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME=""

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret for POST /api/jobs/daily (Vercel Cron / GitHub Action / cURL)
CRON_SECRET="change-me-too"
