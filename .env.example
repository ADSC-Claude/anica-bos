# ---------------------------------------------------------------------------
# ANICA Wellness Spa — Business Operating System
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Postgres connection string used by the app at runtime.
# Supabase: use the POOLED connection (port 6543, ...pooler.supabase.com).
DATABASE_URL="postgresql://anica:anica@127.0.0.1:5432/anica?schema=public"

# Direct connection used only for migrations — a transaction pooler cannot run
# them. Supabase: the DIRECT connection (port 5432). Required only when
# DATABASE_URL points at a pooler; elsewhere leave it out and the build uses
# DATABASE_URL.
DIRECT_URL="postgresql://anica:anica@127.0.0.1:5432/anica?schema=public"

# 32+ char random string used to sign session JWTs.
#   openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public base URL of the deployment (used for PayMongo redirects & emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- PayMongo (online booking reservation fee) ------------------------------
# Test keys start with sk_test_, live keys with sk_live_. Leave blank to run the
# booking flow in SIMULATED gateway mode (dev only).
#
# The publishable key (pk_...) is deliberately absent: checkout sessions are
# created server-side, so nothing here ever runs in the browser and there is no
# key for the browser to hold.
PAYMONGO_SECRET_KEY=""
# Per webhook endpoint, shown once when you create it. Starts with whsk_.
# Test and live endpoints have different secrets.
PAYMONGO_WEBHOOK_SECRET=""

# --- Transactional email ----------------------------------------------------
# Leave RESEND_API_KEY blank to log emails to the console instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="ANICA Wellness Spa <bookings@example.com>"

# --- Optional SMS gateway (Semaphore, PH) -----------------------------------
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME=""

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret for POST /api/jobs/daily (Vercel Cron / GitHub Action / cURL)
CRON_SECRET="change-me-too"

# --- Backups ----------------------------------------------------------------
# Passphrase for `npm run backup`. Set it and the nightly dump is encrypted
# (AES-256-GCM) and written as .json.enc; leave it blank and the dump is plain
# JSON containing every client health record in readable form, and the script
# warns you about it on every run. 12 characters minimum.
#   openssl rand -base64 24
#
# The Owner's in-app download (Settings -> Backup & export) always encrypts and
# asks for its passphrase on the screen — this variable is only for the CLI.
#
# Keep it somewhere that is NOT the drive holding the backups. There is no
# recovery: without the passphrase the file cannot be restored by anyone,
# including you.
BACKUP_PASSPHRASE=""
