# ---------------------------------------------------------------------------
# Digital invitation platform — copy to `.env` and fill in. Never commit `.env`.
#
# Only DATABASE_URL and SESSION_SECRET are required. Everything else degrades
# to something usable: no PayMongo key runs a local simulated checkout, no
# Resend key logs emails to the console, no Supabase key writes uploads to
# public/uploads. A fresh clone runs the whole buy → pay → build → publish →
# RSVP chain with nothing but a database.
# ---------------------------------------------------------------------------

# Postgres used by the app at runtime.
# Supabase: the POOLED connection (port 6543, ...pooler.supabase.com).
DATABASE_URL="postgresql://invites:invites@127.0.0.1:5432/invites?schema=public"

# Direct connection, migrations only — a transaction pooler cannot run them.
# Supabase: the SESSION pooler connection (port 5432, same pooler host).
DIRECT_URL="postgresql://invites:invites@127.0.0.1:5432/invites?schema=public"

# 32+ character random string used to sign session cookies.
#   openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public base URL. Used in emails, PayMongo redirects, share links and QR codes.
# Invitation links are built from it: https://<host>/i/juan-and-maria
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- PayMongo --------------------------------------------------------------
# GCash, Maya, cards and online banking. Test keys start sk_test_, live keys
# sk_live_. Leave blank for SIMULATED mode: a local checkout page that posts
# through the real webhook handler.
#
# No publishable key: checkout sessions are created server-side, so nothing
# here ever runs in the browser and there is no key for the browser to hold.
PAYMONGO_SECRET_KEY=""
# Per webhook endpoint, shown once when you create it. Starts whsk_.
# Test and live endpoints have different secrets.
PAYMONGO_WEBHOOK_SECRET=""

# --- Email -----------------------------------------------------------------
# Blank RESEND_API_KEY logs mail to the console and records it as "logged".
RESEND_API_KEY=""
EMAIL_FROM="Invites <hello@example.com>"

# --- File storage ----------------------------------------------------------
# Cover photos, galleries, GCash QR images, proof-of-payment screenshots.
# Blank falls back to public/uploads on local disk (dev and CI).
# The service-role key is server-side only and must never reach a browser.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLIC_BUCKET="invites-public"
SUPABASE_PRIVATE_BUCKET="invites-private"

# --- Optional SMS gateway (Semaphore, PH) for RSVP reminder blasts ----------
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME=""

# --- Scheduled jobs --------------------------------------------------------
# Bearer secret for POST /api/jobs/daily (Vercel Cron / GitHub Action / cURL).
CRON_SECRET="change-me-too"

# --- Shown on the error page when the database is unreachable ---------------
NEXT_PUBLIC_CONTACT_MESSENGER=""
NEXT_PUBLIC_CONTACT_EMAIL=""
