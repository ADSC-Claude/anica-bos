// Digital invitation platform — Philippines.
//
// Conventions, applied without exception:
//   • Money is an integer number of CENTAVOS. ₱1,999.00 === 199900.
//   • One-time purchases only. There is no subscription anywhere in this schema.
//   • Invitation content is JSON, shaped by src/lib/sections.ts. Every template
//     renders the same shape, so switching templates never loses a field.
//   • Guest links are tokenised. A guest's row is reachable only through a
//     secret token, never through a guessable id.
//   • Nothing that marks money as received is reachable from a browser: the
//     PayMongo webhook and an admin's proof-of-payment review are the only two
//     writers of PaymentStatus.PAID.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// People and access
// ---------------------------------------------------------------------------

/// Staff roles and the customer. A customer's authority is ownership, not a
/// permission list: they may touch what they bought and nothing else.
enum Role {
  ADMIN
  ENCODER
  SUPPORT
  CUSTOMER
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  role               Role      @default(CUSTOMER)
  phone              String    @default("")
  /// Messenger handle or m.me link the customer prefers to be reached on.
  messenger          String    @default("")
  viber              String    @default("")
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  /// Any session token signed before this instant stops working.
  sessionsRevoked    DateTime?
  lastLoginAt        DateTime?
  /// Staff-only notes about a customer (support history, preferences).
  notes              String    @default("")
  /// Set when this person exercised their right to erasure. The row survives
  /// because Order rows point at it and those are receipts the BIR requires
  /// us to keep — but everything on it that identifies a person is gone.
  erasedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  orders           Order[]
  invitations      Invitation[]
  media            Media[]
  assignedJobs     DfyJob[]         @relation("DfyAssignee")
  reviewedPayments Payment[]        @relation("PaymentReviewer")
  notifications    Notification[]
  supportMessages  SupportMessage[]
  dfyRevisions     DfyRevision[]
  loginEvents      LoginEvent[]
  auditLogs        AuditLog[]

  @@index([role, active])
}

model LoginEvent {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  success   Boolean
  reason    String   @default("")
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, success, createdAt])
}

/// Business-wide configuration as JSON. Defaults live in settings-defaults.ts
/// so a fresh install works before anyone opens Settings.
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Catalogue: what is for sale
// ---------------------------------------------------------------------------

enum Occasion {
  WEDDING
  DEBUT
  CHRISTENING
  KIDS_BIRTHDAY
  MILESTONE_BIRTHDAY
  BABY_SHOWER
  ANNIVERSARY
  ENGAGEMENT
  GRADUATION
  COMMUNION
  CORPORATE
  HOUSEWARMING
  REUNION
  MEMORIAL
}

enum Tier {
  BASIC
  STANDARD
  /// Shown as "Signature". Renaming the label was cheaper than renaming the
  /// value, which every order ever sold is stored as.
  COMPLETE
  LUXURY
}

enum ServiceMode {
  DIY
  DFY
  CONCIERGE
}

/// One row per occasion and tier. `occasion` null is the fallback for any
/// occasion without its own row, so a new occasion sells on day one at the
/// generic price and gets its own pricing when the owner decides.
model Package {
  id                String    @id @default(cuid())
  code              String    @unique
  occasion          Occasion?
  tier              Tier
  name              String
  tagline           String    @default("")
  priceCents        Int
  /// Stacked on top of the package when the customer chooses Done-For-You.
  /// Zero since the build was folded into the base price; kept so orders sold
  /// with a separate fee still reconcile.
  dfyFeeCents       Int
  /// Stacked on top when the customer chooses Full Concierge. That mode is
  /// withdrawn; the column is kept for the same reason.
  conciergeFeeCents Int
  /// How many rounds of changes the customer gets on the preview before we
  /// publish: 2, 4 and 6 by tier. Rush and priority cap it lower — there is no
  /// room for four rounds inside 24 hours — see revisionRounds() in
  /// src/lib/pricing.ts. Nothing is revisable after publish.
  revisionRounds    Int
  /// How long the link stays live after the event date.
  linkValidityDays  Int
  active            Boolean   @default(true)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orders Order[]

  @@index([occasion, tier, active])
}

model AddOn {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String   @default("")
  priceCents  Int
  /// A picture of what this buys, shown beside it on the website and in the
  /// checkout. Blank renders nothing rather than a broken frame: most of these
  /// describe something a customer cannot picture from a sentence, and one they
  /// can see is the difference between reading past it and wanting it.
  imageUrl    String   @default("")
  /// A ₱0 add-on that is "priced on request" (SMS credit packs) shows a dash.
  quoted      Boolean  @default(true)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A design. `layout` names the React renderer variant; `palette` and `fonts`
/// are the CSS variables it is themed with; `sections` lists which section keys
/// it lays out (everything else in the content is ignored, not lost).
model Template {
  id               String     @id @default(cuid())
  slug             String     @unique
  name             String
  occasion         Occasion
  // Also offered for these occasions, on top of the home `occasion` above. Empty means the home one only.
  occasions        Occasion[] @default([])
  /// The lowest tier that may use this design.
  minTier          Tier       @default(BASIC)
  /// Premium designs are Complete-only regardless of minTier.
  premium          Boolean    @default(false)
  description      String     @default("")
  thumbnailUrl     String     @default("")
  layout           String     @default("classic")
  /// Colour family shown as a strip in the gallery. See src/lib/collections.ts. "" means it belongs to none.
  collection       String     @default("")
  /// The opening this design ships with. The customer may override it. See src/lib/openings.ts.
  opening          String     @default("")
  /// A cinematic opening's shared assets: the clip that plays on tap and the
  /// still shown in its place until it does. One pair per design, served to
  /// every customer on it — never rendered per couple.
  openingVideoUrl  String     @default("")
  openingPosterUrl String     @default("")
  /// The slug of the invitation that shows this design off: a visitor may
  /// scroll it from the opening to Our Story (the peek) before choosing the
  /// design, whatever its status. Blank means no peek is offered.
  demoSlug         String     @default("")
  palette          Json
  fonts            Json
  /// The look this design is set in — its faces and the lines under its
  /// headings. See src/lib/looks.ts. Blank means the `fonts` column alone.
  look             String     @default("")
  /// The words the design writes over its look's, per language:
  /// {"en": {"gallery": "…"}, "tl": {…}}. See src/lib/design.ts.
  words            Json       @default("{}")
  /// The design's own pictures, by URL — its backgrounds by day and by night,
  /// its strand. Blank falls back to the files shipped with the layout. See src/lib/design.ts.
  art              Json       @default("{}")
  /// The design document a guest's page is drawn from: its pages, the ground
  /// under each one, and the photo frames and writings placed on the drawn
  /// ones. `{}` means "the layout's built-in", which is what every design
  /// carries today, so an empty column renders exactly as the code does. See
  /// src/lib/design.ts.
  design           Json       @default("{}")
  /// The studio's working copy of that document. Nothing a guest sees comes
  /// from here: it is published into `design` when the owner is happy with it.
  designDraft      Json       @default("{}")
  /// Bumped on every draft save. Two people editing the same draft each hold
  /// the revision they loaded, so the second save is refused rather than
  /// silently overwriting the first.
  designDraftRev   Int        @default(0)
  /// The secret in a Share-draft link. Blank means the design is not shared;
  /// changing it makes every link handed out so far stop working, which is
  /// what Stop sharing does.
  shareNonce       String     @default("")
  sections         String[]
  featured         Boolean    @default(false)
  published        Boolean    @default(true)
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  invitations Invitation[]
  media       Media[]

  @@index([occasion, published, sortOrder])
  @@index([collection, published, sortOrder])
}

enum DiscountType {
  PERCENT
  FIXED
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  type          DiscountType
  /// Whole percent for PERCENT (10 === 10%); centavos for FIXED.
  value         Int
  minSpendCents Int          @default(0)
  expiresAt     DateTime?
  usageLimit    Int?
  usedCount     Int          @default(0)
  active        Boolean      @default(true)
  note          String       @default("")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders Order[]
}

// ---------------------------------------------------------------------------
// Orders and money
// ---------------------------------------------------------------------------

/// PENDING_PAYMENT → PAID (money confirmed) → ACTIVE (invitation unlocked).
/// PAID and ACTIVE are set in the same transaction today; they are separate
/// states so a future manual review step has somewhere to sit.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  ACTIVE
  CANCELLED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  reference       String      @unique
  userId          String
  packageId       String
  couponId        String?
  invitationId    String?     @unique
  occasion        Occasion
  tier            Tier
  serviceMode     ServiceMode
  /// The package price alone.
  subtotalCents   Int
  addOnsCents     Int         @default(0)
  serviceFeeCents Int         @default(0)
  discountCents   Int         @default(0)
  totalCents      Int
  status          OrderStatus @default(PENDING_PAYMENT)
  /// What the customer told us at checkout — event date, template wish, etc.
  notes           String      @default("")
  paidAt          DateTime?
  activatedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  package    Package     @relation(fields: [packageId], references: [id])
  coupon     Coupon?     @relation(fields: [couponId], references: [id])
  invitation Invitation? @relation(fields: [invitationId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  dfyJob     DfyJob?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  /// PACKAGE | ADDON | SERVICE | DISCOUNT
  kind        String
  code        String
  name        String
  amountCents Int
  sortOrder   Int    @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum PaymentProvider {
  PAYMONGO
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REJECTED
  REFUNDED
}

model Payment {
  id               String          @id @default(cuid())
  reference        String          @unique
  orderId          String
  provider         PaymentProvider
  status           PaymentStatus   @default(PENDING)
  amountCents      Int
  /// GCash, Maya, BPI, BDO, UnionBank, card… as reported by the gateway or
  /// chosen by the customer on the manual form.
  channel          String          @default("")
  gatewaySessionId String?
  gatewayPaymentId String?
  /// Webhook idempotency: an event id is applied once.
  gatewayEventId   String?         @unique
  checkoutUrl      String          @default("")
  /// Manual transfers: the screenshot, and what the customer typed beside it.
  proofUrl         String          @default("")
  proofStoragePath String          @default("")
  payerName        String          @default("")
  payerReference   String          @default("")
  failureReason    String          @default("")
  rejectReason     String          @default("")
  reviewedById     String?
  reviewedAt       DateTime?
  paidAt           DateTime?
  refundedCents    Int             @default(0)
  refundId         String          @default("")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("PaymentReviewer", fields: [reviewedById], references: [id])

  @@index([orderId, status])
  @@index([provider, status, createdAt])
}

// ---------------------------------------------------------------------------
// The product: an invitation
// ---------------------------------------------------------------------------

enum InvitationStatus {
  DRAFT
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum Privacy {
  PUBLIC
  UNLISTED
  PASSWORD
}

model Invitation {
  id                String           @id @default(cuid())
  userId            String
  templateId        String
  occasion          Occasion
  tier              Tier
  /// "Juan & Maria" — used in the dashboard, page title and OG preview.
  title             String
  slug              String           @unique
  status            InvitationStatus @default(DRAFT)
  privacy           Privacy          @default(PUBLIC)
  passwordHash      String?
  /// Section data keyed by section key. See src/lib/sections.ts.
  content           Json
  /// en | tl — which phrasing the guest page uses for its fixed labels.
  language          String           @default("en")
  eventAt           DateTime?
  /// The link stops resolving after this. Set from the package on publish.
  expiresAt         DateTime?
  ogImageUrl        String           @default("")
  /// A cinematic opening encoded for this couple alone, overriding the
  /// design's shared one. Staff set these on a Done-For-You or Concierge
  /// order; they are not customer content and never pass through the builder.
  openingVideoUrl   String           @default("")
  openingPosterUrl  String           @default("")
  /// The premium opening video add-on, bought with the order or switched on
  /// by staff. Without it the design's clip is not played and the guest gets
  /// the opening every package includes.
  premiumOpening    Boolean          @default(false)
  /// Which of the design's premium openings this invitation plays. A theme may
  /// have several clips and the customer picks among them (see
  /// src/lib/premium-openings.ts); blank means the design's first. A key that
  /// no longer fits the design — after a design change — falls back to that
  /// first one rather than playing another theme's artwork.
  premiumOpeningKey String           @default("")
  /// Retired, both of them: they counted a customer's saves after publish
  /// against an allowance from the package. Revisions happen before we
  /// publish now, so nothing spends or reads these; they are kept rather than
  /// dropped so the history of an invitation sold under the old rule survives.
  editsUsed         Int              @default(0)
  editsAllowed      Int              @default(3)
  publishedAt       DateTime?
  viewCount         Int              @default(0)
  rsvpDeadline      DateTime?
  rsvpClosed        Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  /// A Save the Date announces the invitation it hangs off: the same couple,
  /// the same design, its own link and its own publish clock. It is bought as
  /// an add-on and has no order of its own. Null on an ordinary invitation.
  saveTheDateOfId String? @unique

  /// The add-on codes this invitation was sold with, copied from the order's
  /// line items when it activates. Some of them buy a feature outright on a
  /// package that does not include it — see ADDON_FEATURE in src/lib/tiers.ts
  /// — so what an invitation may do is read from the tier and from here.
  ///
  /// Copied rather than joined through the order because staff create
  /// invitations with no order at all, and because an order's line items are a
  /// record of a sale: switching one on for a customer who was owed it should
  /// not mean editing what they were billed.
  addOns          String[] @default([])

  /// Parts this one invitation carries that its design does not draw — a
  /// programme on a design with no programme page, a gift note on one that
  /// never had one. Staff set them and nobody else: a customer asks, and we
  /// tick it on. The design is untouched, so nobody else on it moves.
  ///
  /// It never buys anything. A part the package does not include stays
  /// refused here exactly as it is refused on the form: the tier and the
  /// add-ons decide what an invitation may show, and this decides only
  /// whether the design draws it. See src/lib/parts.ts.
  extraSections   String[] @default([])

  /// What this couple's guests are sent, and how it is worded: the tone they
  /// picked, and any message they rewrote. Only what differs from the library
  /// in src/lib/messages.ts is stored, so improving a stock line improves it
  /// for everyone who never touched it.
  ///
  /// Not `messages`: that is already the support thread with this invitation's
  /// owner, and two things called messages on one row is how you end up
  /// e-mailing a guest a reply meant for staff.
  guestMessages   Json     @default("{}")

  user          User        @relation(fields: [userId], references: [id])
  template      Template    @relation(fields: [templateId], references: [id])
  order         Order?
  saveTheDateOf Invitation? @relation("SaveTheDate", fields: [saveTheDateOfId], references: [id], onDelete: Cascade)
  saveTheDate   Invitation? @relation("SaveTheDate")

  guests    Guest[]
  rsvps     Rsvp[]
  tables    SeatingTable[]
  guestbook GuestbookEntry[]
  media     Media[]
  views     InvitationView[]
  dfyJob    DfyJob?
  messages  SupportMessage[]
  texts     SmsMessage[]
  emails    EmailMessage[]

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

/// A named invitee with a personal link. The token is the only public handle.
model Guest {
  id             String    @id @default(cuid())
  invitationId   String
  name           String
  /// Free-text tag: "Bride's family", "Office", "Ninongs".
  groupName      String    @default("")
  seatsAllotted  Int       @default(1)
  plusOneAllowed Boolean   @default(false)
  token          String    @unique
  tableId        String?
  phone          String    @default("")
  email          String    @default("")
  notes          String    @default("")
  /// Personal greeting override, e.g. "Mr. & Mrs. Dela Cruz".
  salutation     String    @default("")
  checkedInAt    DateTime?
  checkedInBy    String    @default("")
  /// How many of this party actually walked in, counted at the door. Null
  /// means nobody counted — an arrival recorded before the stepper existed, or
  /// a scan nobody adjusted — and reads as the whole confirmed party. Not
  /// capped at what they confirmed: parties turn up with an extra cousin.
  arrivedCount   Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invitation Invitation     @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  table      SeatingTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  rsvps      Rsvp[]
  texts      SmsMessage[]
  emails     EmailMessage[]

  @@index([invitationId, groupName])
}

model SeatingTable {
  id           String @id @default(cuid())
  invitationId String
  name         String
  capacity     Int    @default(10)
  sortOrder    Int    @default(0)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guests     Guest[]

  @@index([invitationId, sortOrder])
}

enum RsvpResponse {
  ACCEPT
  DECLINE
}

/// One response per guest link (updated in place) or one per open-form
/// submission (no guest). Attendee names are stored so the couple can print a
/// list, and so a "party of 4" is four names and not a number.
model Rsvp {
  id           String       @id @default(cuid())
  invitationId String
  guestId      String?
  name         String
  response     RsvpResponse
  /// Which set they said they belong to: "Principal sponsors", "College
  /// friends". Chosen from the list the couple writes on the RSVP section.
  groupName    String       @default("")
  seats        Int          @default(1)
  attendees    Json
  mealChoice   String       @default("")
  dietary      String       @default("")
  message      String       @default("")
  phone        String       @default("")
  email        String       @default("")
  /// Corporate events ask which department or company the guest is from. Its
  /// own column because it is not a contact detail: it used to ride along on
  /// `email` as "address · department", which put a department on a mailing
  /// list and an address nowhere a blast could read it.
  department   String       @default("")
  ip           String       @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  invitation Invitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest?            @relation(fields: [guestId], references: [id], onDelete: SetNull)
  emails     EmailMessage[]

  @@index([invitationId, response])
  @@index([ip, createdAt])
}

model GuestbookEntry {
  id           String   @id @default(cuid())
  invitationId String
  name         String
  message      String
  approved     Boolean  @default(false)
  ip           String   @default("")
  createdAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, approved, createdAt])
  @@index([ip, createdAt])
}

enum MediaKind {
  COVER
  GALLERY
  VENUE
  QR
  PROOF
  INTAKE
  GUEST_PHOTO
  /// The couple's own song file, from the Music section.
  AUDIO
  /// A design's own picture, uploaded in the studio: a page's ground, a piece
  /// from the library, a thumbnail. Belongs to a template, never to a couple.
  DESIGN_IMAGE
  /// A design's own clip, uploaded in the studio.
  DESIGN_VIDEO
  /// A piece in the library: uploaded once, usable in any design, so it
  /// belongs to no template and to no couple.
  DESIGN_PIECE
  OTHER
}

model Media {
  id           String    @id @default(cuid())
  userId       String?
  invitationId String?
  /// Set for a design's own upload (DESIGN_IMAGE, DESIGN_VIDEO), which belongs
  /// to the template rather than to any one couple.
  templateId   String?
  kind         MediaKind @default(OTHER)
  url          String
  storagePath  String
  contentType  String
  caption      String    @default("")
  /// Who sent it, for a GUEST_PHOTO. A guest has no account to attribute it to.
  uploadedBy   String    @default("")
  /// Guest photo uploads wait here until the couple approves them.
  approved     Boolean   @default(true)
  sortOrder    Int       @default(0)
  /// Set for public uploads only, so an abusive connection can be rate limited.
  ip           String    @default("")
  /// Read from the file on upload, never typed: a ground's height as a share
  /// of its width is what places every element on a drawn page, and a clip's
  /// length is what the studio warns about.
  width        Int?
  height       Int?
  bytes        Int?
  durationMs   Int?
  /// A library piece's own name and the words she would search for it by.
  /// Blank on everything else: a guest photo is not something anybody tags.
  name         String    @default("")
  tags         String[]  @default([])
  createdAt    DateTime  @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  template   Template?   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([invitationId, kind, sortOrder])
  @@index([invitationId, kind, approved, createdAt])
  @@index([templateId, kind, sortOrder])
  @@index([kind, createdAt])
  @@index([ip, createdAt])
}

/// Page views per day. A counter, not analytics — enough for "how many people
/// opened it" without a tracking script on the guest page.
model InvitationView {
  id           String   @id @default(cuid())
  invitationId String
  day          DateTime @db.Date
  count        Int      @default(0)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, day])
}

// ---------------------------------------------------------------------------
// Done-For-You
// ---------------------------------------------------------------------------

enum DfyStatus {
  NEW
  INTAKE_RECEIVED
  ENCODING
  PREVIEW_SENT
  REVISION
  APPROVED
  PUBLISHED
}

model DfyJob {
  id                String    @id @default(cuid())
  orderId           String    @unique
  invitationId      String    @unique
  status            DfyStatus @default(NEW)
  assigneeId        String?
  /// FORM | MESSENGER | EXCEL — how the customer said they would send details.
  intakeMethod      String    @default("FORM")
  intake            Json?
  intakeSubmittedAt DateTime?
  /// SLA: when the preview is due, from the service mode's turnaround.
  dueAt             DateTime?
  previewSentAt     DateTime?
  approvedAt        DateTime?
  publishedAt       DateTime?
  revisionsAllowed  Int       @default(2)
  revisionsUsed     Int       @default(0)
  internalNotes     String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invitation Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  assignee   User?         @relation("DfyAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  revisions  DfyRevision[]

  @@index([status, dueAt])
  @@index([assigneeId, status])
}

/// The conversation on a job: a customer's change requests, and the encoder's
/// replies. `round` groups a request with the work done for it.
model DfyRevision {
  id         String   @id @default(cuid())
  jobId      String
  round      Int
  authorId   String?
  authorName String
  byStaff    Boolean
  body       String
  createdAt  DateTime @default(now())

  job    DfyJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
}

// ---------------------------------------------------------------------------
// Support, notifications, audit
// ---------------------------------------------------------------------------

model SupportMessage {
  id           String    @id @default(cuid())
  userId       String
  invitationId String?
  fromStaff    Boolean   @default(false)
  body         String
  /// app | messenger | viber | email — where the reply should go.
  channel      String    @default("app")
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([fromStaff, readAt])
}

/// One text message we sent, or tried to. Kept so the couple can see who was
/// reached, and so a second blast does not re-text someone we just texted —
/// every send costs a credit and irritates a guest.
model SmsMessage {
  id           String    @id @default(cuid())
  invitationId String
  guestId      String?
  to           String
  body         String
  /// Which scheduled message this was — sevenDay, oneDay, sameDay, thankYou.
  /// Blank for a reminder the couple sent by hand. It is what stops the daily
  /// job sending the same campaign twice, so without it the job cannot tell a
  /// seven-day reminder from the one-day it sends six days later.
  campaign     String    @default("")
  status       SmsStatus @default(LOGGED)
  error        String    @default("")
  createdAt    DateTime  @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([invitationId, createdAt])
  @@index([guestId, createdAt])
  @@index([invitationId, campaign])
}

/// One e-mail sent to one guest, kept for the same two reasons as SmsMessage:
/// a blast should be able to say what it did, and the next blast has to know
/// who it has already written to today.
model EmailMessage {
  id           String    @id @default(cuid())
  invitationId String
  guestId      String?
  /// Set when this is the confirmation of one reply, so the couple's RSVP list
  /// can say whether that guest was written to. A blast carries no rsvpId.
  rsvpId       String?
  to           String
  subject      String
  body         String
  /// Which scheduled message this was. See SmsMessage.campaign.
  campaign     String    @default("")
  status       SmsStatus @default(LOGGED)
  error        String    @default("")
  createdAt    DateTime  @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)
  rsvp       Rsvp?      @relation(fields: [rsvpId], references: [id], onDelete: SetNull)

  @@index([invitationId, createdAt])
  @@index([guestId, createdAt])
  @@index([rsvpId])
  @@index([invitationId, campaign])
}

/// Shared with EmailMessage: sent, written to the log because no key is set,
/// or refused. The three outcomes are the same whichever gateway carried it.
enum SmsStatus {
  SENT
  LOGGED
  FAILED
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String    @default("")
  href      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// Append-only. Nothing in the application updates or deletes a row.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String
  role       String
  module     String
  action     String
  entityType String
  entityId   String   @default("")
  summary    String   @default("")
  before     Json?
  after      Json?
  sensitive  Boolean  @default(false)
  ip         String   @default("")
  userAgent  String   @default("")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
