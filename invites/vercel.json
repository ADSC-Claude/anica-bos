{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/build.mjs",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD ./",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/jobs/daily",
      "schedule": "0 22 * * *"
    }
  ]
}
