{
  "name": "anica-bos",
  "version": "1.0.0",
  "private": true,
  "description": "ANICA Wellness Spa — Business Operating System",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "jobs:daily": "tsx scripts/daily-jobs.ts",
    "verify": "tsx scripts/verify-integrity.ts",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "build:local": "prisma generate && next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "3.0.2",
    "jose": "6.2.5",
    "next": "15.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "5.7.2"
  }
}
