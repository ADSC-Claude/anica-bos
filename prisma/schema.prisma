// ============================================================ tenancy & settings

model Branch {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String   @default("")
  contact     String   @default("")
  openMinute  Int      @default(720) // 12:00 PM, minutes from midnight
  closeMinute Int      @default(1440) // 12:00 AM next day
  timezone    String   @default("Asia/Manila")
  active      Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users          User[]
  employees      Employee[]
  clients        Client[]
  appointments   Appointment[]
  sales          Sale[]
  resources      Resource[]
  items          Item[]
  stockMovements StockMovement[]
  expenses       Expense[]
  receiptSeries  ReceiptSeries[]
  eodClosings    EodClosing[]
  pettyCashTxns  PettyCashTxn[]
  purchaseOrders PurchaseOrder[]
  settings       Setting[]
  payrollPeriods PayrollPeriod[]
  stockTakes     StockTake[]
  journalEntries JournalEntry[]
  notifications  Notification[]
  shiftNotes     ShiftNote[]
  announcements  Announcement[]
  attendances    Attendance[]

  @@index([active])
}

/// Key/value settings. `branchId == null` means a global (business-wide) value.
model Setting {
  id       String  @id @default(cuid())
  key      String
  value    Json
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([key, branchId])
  @@index([key])
}

// ============================================================ auth & audit

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  role               Role
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  approvalPinHash    String?
  lastLoginAt        DateTime?
  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id])
  employeeId         String?   @unique
  employee           Employee? @relation(fields: [employeeId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auditLogs         AuditLog[]
  loginEvents       LoginEvent[]
  sentMessages      DirectMessage[]    @relation("MessageFrom")
  receivedMessages  DirectMessage[]    @relation("MessageTo")
  announcements     Announcement[]
  announcementReads AnnouncementRead[]
  notifications     Notification[]
  shiftNotes        ShiftNote[]
  shiftNoteComments ShiftNoteComment[]
  expensesSubmitted Expense[]          @relation("ExpenseSubmitter")
  expensesApproved  Expense[]          @relation("ExpenseApprover")
  salesCashiered    Sale[]             @relation("SaleCashier")
  salesVoided       Sale[]             @relation("SaleVoider")
  eodClosings       EodClosing[]
  sessionsRevoked   DateTime?

  @@index([role, active])
}

model LoginEvent {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  success   Boolean
  ip        String   @default("")
  userAgent String   @default("")
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

/// Append-only. Covers both the sensitive-action audit log and the general
/// activity log (every create/edit/void/status change on business records).
/// Never edited or deleted by anyone, including the Owner.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  userName   String   @default("system")
  role       String   @default("")
  branchId   String?
  module     String
  action     String
  entityType String
  entityId   String   @default("")
  summary    String   @default("")
  before     Json?
  after      Json?
  sensitive  Boolean  @default(false)
  ip         String   @default("")
  userAgent  String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([module, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// ============================================================ catalog

model ServiceCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  sortRank Int     @default(0)
  active   Boolean @default(true)

  /// Services whose primary category this is. Reports, the POS and commissions
  /// all read this one, so a sale belongs to exactly one category and revenue
  /// cannot be counted twice.
  services   Service[] @relation("PrimaryCategory")
  /// Services listed here as well, on the public price list only.
  alsoListed Service[] @relation("AdditionalCategories")
}

model Service {
  id                   String            @id @default(cuid())
  name                 String
  categoryId           String
  category             ServiceCategory   @relation("PrimaryCategory", fields: [categoryId], references: [id])
  /// Extra headings this service also appears under on the public price list.
  /// Deliberately display-only: a treatment that spans two categories should be
  /// findable under both without its revenue landing in two places.
  alsoInCategories     ServiceCategory[] @relation("AdditionalCategories")
  description          String            @default("")
  durationMinutes      Int
  priceCents           Int
  /// null => use the global default commission rule
  commissionType       DiscountType?
  commissionValue      Int? // percent basis points not needed: percent stored as whole number, fixed stored as centavos
  /// The kind of place this treatment needs. Null means any — a service
  /// that requires a bed must not be offered the foot-spa chair, and a foot
  /// spa occupying a bed is a bed that cannot be sold.
  requiredResourceType ResourceType?
  /// Where this treatment usually falls in a visit. Lower runs first, so a
  /// sauna at 10 comes before a massage at 30 without anybody being asked.
  /// A number rather than a rule in code, so the spa can reorder its own flow.
  sequenceRank         Int               @default(50)
  /// Minutes needed after this treatment before the next can start, when the
  /// house default is not right — a sauna needs a shower, a foot spa does not.
  /// Null means use the branch default.
  changeoverMinutes    Int?
  /// An extra that runs on the end of the treatment before it, in the same
  /// place and with no gap. A hot compress after a massage is not a second
  /// appointment: she does not get up and the bed is not turned over, so
  /// charging the visit five minutes of floor time for it invents work.
  isAddOn              Boolean           @default(false)
  active               Boolean           @default(true)
  showOnLanding        Boolean           @default(true)
  sortRank             Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  recipes             ServiceRecipe[]
  appointmentServices AppointmentService[]
  saleLines           SaleLine[]
  employeeSkills      EmployeeSkill[]
  packageItems        PackageItem[]
  commissionOverrides EmployeeCommissionRule[]

  @@index([active])
}

model ServiceRecipe {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item    @relation(fields: [itemId], references: [id])
  quantity  Float

  @@unique([serviceId, itemId])
}

model Resource {
  id           String       @id @default(cuid())
  branchId     String
  branch       Branch       @relation(fields: [branchId], references: [id])
  name         String
  type         ResourceType
  capacity     Int          @default(1)
  /// Whether the places in here are shared between unrelated bookings.
  ///
  /// A row of open beds is shared: two strangers lie on Bed 1 and Bed 2 quite
  /// happily. A couples room and the sauna are not — one party takes the whole
  /// thing, and it is unavailable to anyone else until they leave, however many
  /// places are technically free inside it.
  ///
  exclusiveUse Boolean      @default(false)
  /// Whether a booking must take *every* place in here, or may take fewer.
  ///
  /// These are two different rules and they were one flag, which is how the
  /// sauna came to be refused to a single guest. A couples room must be filled:
  /// one person in Room 1 leaves a bed nobody can book, so it is offered only to
  /// a pair. The sauna must not be: it holds four, but one person booking it
  /// alone is a normal sale — she simply has it to herself, and the next booking
  /// takes it after her.
  ///
  /// Only meaningful when `exclusiveUse` is set, since a shared place never has
  /// to be filled by anyone.
  fillWhole    Boolean      @default(false)
  active       Boolean      @default(true)
  sortRank     Int          @default(0)

  appointments Appointment[]
  /// Individual treatments held here. A visit's sauna leg and its massage leg
  /// are separate holds on separate places.
  segments     AppointmentService[]

  @@unique([branchId, name])
}

// ============================================================ clients / CRM

model Client {
  id                   String    @id @default(cuid())
  branchId             String
  branch               Branch    @relation(fields: [branchId], references: [id])
  name                 String
  mobile               String
  email                String    @default("")
  birthday             DateTime?
  addressCity          String    @default("")
  addressLine          String    @default("")
  barangay             String    @default("")
  notes                String    @default("")
  tags                 String[]  @default([])
  /// Walk-in quick records (name + mobile only) are flagged for completion.
  incomplete           Boolean   @default(false)
  pwdIdNumber          String    @default("")
  seniorIdNumber       String    @default("")
  loyaltyPoints        Int       @default(0)
  /// PH Data Privacy Act consent for sensitive personal information.
  consentGiven         Boolean   @default(false)
  consentAt            DateTime?
  medicalUpdatedAt     DateTime?
  followUpSnoozedUntil DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  fieldValues      ClientFieldValue[]
  appointments     Appointment[]
  sales            Sale[]
  feedback         ClientFeedback[]
  followUps        ClientFollowUp[]
  packages         ClientPackage[]
  loyaltyTxns      LoyaltyTransaction[]
  corporateLinks   CorporateAccountClient[]
  emailLogs        EmailLog[]
  shiftNotes       ShiftNote[]
  giftCertificates GiftCertificate[]

  @@unique([branchId, mobile])
  @@index([name])
  @@index([email])
}

/// Owner/Admin-editable intake questions. Drives BOTH the online booking form
/// (when showOnline) and the CRM intake screen — nothing is hard-coded.
model ClientFieldDefinition {
  id          String       @id @default(cuid())
  key         String       @unique
  label       String
  section     FieldSection
  type        FieldType
  options     String[]     @default([])
  helpText    String       @default("")
  required    Boolean      @default(false)
  showOnline  Boolean      @default(false)
  /// Values that should raise a visible alert on the appointment card / POS.
  alertValues String[]     @default([])
  sortRank    Int          @default(0)
  retired     Boolean      @default(false)
  createdAt   DateTime     @default(now())

  values ClientFieldValue[]

  @@index([section, retired])
}

model ClientFieldValue {
  id           String                @id @default(cuid())
  clientId     String
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  definitionId String
  definition   ClientFieldDefinition @relation(fields: [definitionId], references: [id])
  value        Json
  updatedAt    DateTime              @updatedAt

  @@unique([clientId, definitionId])
}

model ClientFeedback {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId String?
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  rating        Int
  comment       String    @default("")
  recordedBy    String    @default("")
  /// Whether this may be quoted on the public landing page.
  ///
  /// Defaults to false and must be ticked deliberately. Feedback given to a
  /// receptionist at the counter is not the same act as publishing a review
  /// under your own name on a website anyone can read — so nothing appears
  /// there until someone confirms the guest is happy for it to.
  showOnLanding Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([clientId])
  @@index([employeeId])
}

model ClientFollowUp {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel   String // email | sms | call | messenger
  note      String   @default("")
  userId    String?
  userName  String   @default("")
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model CorporateAccount {
  id               String       @id @default(cuid())
  name             String
  tin              String       @default("")
  billingAddress   String       @default("")
  contactPerson    String       @default("")
  contactMobile    String       @default("")
  contactEmail     String       @default("")
  discountType     DiscountType @default(PERCENT)
  discountValue    Int          @default(0)
  creditLimitCents Int          @default(0)
  paymentTermsDays Int          @default(30)
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  clients    CorporateAccountClient[]
  sales      Sale[]
  statements CorporateStatement[]
  payments   CorporatePayment[]
}

model CorporateAccountClient {
  id        String           @id @default(cuid())
  accountId String
  account   CorporateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([accountId, clientId])
}

model CorporateStatement {
  id          String           @id @default(cuid())
  accountId   String
  account     CorporateAccount @relation(fields: [accountId], references: [id])
  number      String           @unique
  periodStart DateTime
  periodEnd   DateTime
  totalCents  Int
  dueDate     DateTime
  issuedAt    DateTime         @default(now())
  settled     Boolean          @default(false)

  @@index([accountId])
}

model CorporatePayment {
  id          String           @id @default(cuid())
  accountId   String
  account     CorporateAccount @relation(fields: [accountId], references: [id])
  amountCents Int
  method      PaymentMethod
  reference   String           @default("")
  paidAt      DateTime         @default(now())
  recordedBy  String           @default("")
  note        String           @default("")

  @@index([accountId, paidAt])
}

model Partner {
  id                 String       @id @default(cuid())
  name               String
  type               String       @default("hotel") // hotel | condo | office | gym | influencer | other
  contactPerson      String       @default("")
  contactMobile      String       @default("")
  contactEmail       String       @default("")
  /// What we owe the partner per referred sale.
  feeType            DiscountType @default(PERCENT)
  feeValue           Int          @default(0)
  guestDiscountType  DiscountType @default(PERCENT)
  guestDiscountValue Int          @default(0)
  promoCode          String?      @unique
  terms              String       @default("")
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())

  appointments Appointment[]
  sales        Sale[]
}

// ============================================================ employees

/// Where someone stands with the business. `active` stays as the operational
/// flag every roster, POS and payroll query already filters on; this is the
/// human answer, and it is what the Owner sets.
enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  SEPARATED
}

model Employee {
  id              String           @id @default(cuid())
  branchId        String
  branch          Branch           @relation(fields: [branchId], references: [id])
  /// Full legal name, assembled from the parts below. This is what payroll and
  /// the government forms carry — SSS and BIR do not know anyone as "Ms. Jenny".
  name            String
  firstName       String           @default("")
  middleName      String           @default("")
  lastName        String           @default("")
  /// What everyone actually calls her — clients, the desk, the manager. Blank
  /// means her first name serves, which is the common case.
  nickname        String           @default("")
  /// Ms. / Mr. / Mx. A field rather than a constant: the spa's therapists are
  /// all women today, and the day one is not, nobody should have to change code
  /// to stop the booking page addressing him wrongly.
  title           String           @default("Ms.")
  /// "Ms. Jenny" — how she appears everywhere except payroll and government
  /// forms. Stored rather than computed on read so lists can sort and search on
  /// it in the database, the same as any other name.
  displayName     String           @default("")
  photoUrl        String           @default("")
  employeeRole    EmployeeRole
  mobile          String           @default("")
  email           String           @default("")
  address         String           @default("")
  emergencyName   String           @default("")
  emergencyMobile String           @default("")
  /// Date of birth. Asked for by SSS, PhilHealth, Pag-IBIG and BIR on every
  /// form, and the only way the spa knows whose birthday it is.
  birthday        DateTime?
  hireDate        DateTime         @default(now())
  /// Derived from `status` — kept because the roster, POS, availability and
  /// payroll all filter on it, and a status change must not silently leave
  /// someone bookable.
  active          Boolean          @default(true)
  status          EmploymentStatus @default(ACTIVE)
  /// The current spell: when this status began, and — for leave and suspension
  /// — when it is due to end. One pair of dates for every status rather than a
  /// field per status, so "since when" is answerable without knowing which.
  statusFrom      DateTime?
  statusUntil     DateTime?
  statusReason    String           @default("")

  // --- government numbers (Owner/Admin only) ---
  sssNumber              String @default("")
  philhealthNumber       String @default("")
  pagibigNumber          String @default("")
  tin                    String @default("")
  sssMonthlyCents        Int    @default(0)
  philhealthMonthlyCents Int    @default(0)
  pagibigMonthlyCents    Int    @default(0)

  // --- pay structure ---
  /// THERAPIST => DAILY_ALLOWANCE (default ₱200/day).
  /// RECEPTIONIST / MANAGER => Owner-only DAILY_RATE or FIXED_SALARY.
  payType      PayType @default(DAILY_ALLOWANCE)
  payRateCents Int     @default(20000)
  /// Only the Owner may read/write pay fields when this is true.
  payOwnerOnly Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User?
  skills              EmployeeSkill[]
  schedules           EmployeeSchedule[]
  attendances         Attendance[]
  loans               EmployeeLoan[]
  commissions         Commission[]
  payslips            Payslip[]
  saleLines           SaleLine[]
  appointmentServices AppointmentService[]
  feedback            ClientFeedback[]
  commissionRules     EmployeeCommissionRule[]
  certifications      Permit[]
  employeeRateSales   Sale[]                   @relation("EmployeeRateSale")
  incentiveResults    IncentiveResult[]
  employmentEvents    EmploymentEvent[]

  @@index([branchId, active])
}

/// Every change of employment status, kept forever.
///
/// The Employee row answers "where do they stand today"; this answers "has this
/// happened before, and when". A suspension that leaves no trace once it is
/// lifted is not a record — and a second one is a different conversation from a
/// first.
model EmploymentEvent {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status     EmploymentStatus
  /// Effective date of the change — the last day worked, the first day of
  /// leave — not when someone got round to typing it in.
  startDate  DateTime
  /// Expected end, for leave and suspension. Null means open-ended.
  endDate    DateTime?
  reason     String           @default("")
  recordedBy String           @default("")
  createdAt  DateTime         @default(now())

  @@index([employeeId, startDate])
}

model EmployeeSkill {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId])
}

model EmployeeCommissionRule {
  id         String       @id @default(cuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    Service?     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  type       DiscountType
  value      Int

  @@unique([employeeId, serviceId])
}

model EmployeeSchedule {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  isDayOff    Boolean  @default(false)
  startMinute Int      @default(720)
  endMinute   Int      @default(1440)

  @@unique([employeeId, dayOfWeek])
}

model Attendance {
  id           String    @id @default(cuid())
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id])
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Business date (Asia/Manila) at 00:00 UTC-normalised.
  workDate     DateTime  @db.Date
  timeIn       DateTime?
  timeOut      DateTime?
  isLate       Boolean   @default(false)
  isAbsent     Boolean   @default(false)
  lateMinutes  Int       @default(0)
  /// Sequence of time-in for the day — drives the therapist rotation queue.
  rotationRank Int       @default(0)
  onBreak      Boolean   @default(false)
  note         String    @default("")
  recordedBy   String    @default("")
  createdAt    DateTime  @default(now())

  @@unique([employeeId, workDate])
  @@index([branchId, workDate])
}

model EmployeeLoan {
  id               String     @id @default(cuid())
  employeeId       String
  employee         Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type             LoanType
  principalCents   Int
  installmentCents Int
  balanceCents     Int
  startDate        DateTime
  status           LoanStatus @default(ACTIVE)
  note             String     @default("")
  createdAt        DateTime   @default(now())

  payments LoanPayment[]

  @@index([employeeId, status])
}

model LoanPayment {
  id          String       @id @default(cuid())
  loanId      String
  loan        EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amountCents Int
  payslipId   String?
  paidAt      DateTime     @default(now())
  note        String       @default("")
}

model PayrollPeriod {
  id          String        @id @default(cuid())
  branchId    String
  branch      Branch        @relation(fields: [branchId], references: [id])
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  status      PayrollStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  finalizedAt DateTime?
  finalizedBy String?

  payslips Payslip[]

  @@unique([branchId, startDate, endDate])
}

model Payslip {
  id         String        @id @default(cuid())
  periodId   String
  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])

  daysWorked      Int @default(0)
  holidayDays     Int @default(0)
  basePayCents    Int @default(0)
  commissionCents Int @default(0)
  tipsCents       Int @default(0)
  additionsCents  Int @default(0)
  deductionsCents Int @default(0)
  netPayCents     Int @default(0)

  status    PayrollStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  lines PayslipLine[]

  @@unique([periodId, employeeId])
}

model PayslipLine {
  id          String  @id @default(cuid())
  payslipId   String
  payslip     Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  /// base | commission | tips | holiday | late | absence | loan | contribution | adjustment
  kind        String
  label       String
  /// Positive = addition, negative = deduction.
  amountCents Int
  sortRank    Int     @default(0)
  manual      Boolean @default(false)
}

/// Owner-only. Never released through payroll; never appears on a payslip.
model IncentiveScheme {
  id          String           @id @default(cuid())
  name        String
  targetRole  EmployeeRole
  formula     IncentiveFormula
  /// FIXED_AMOUNT => centavos. PERCENT_* => whole percent.
  value       Int
  /// Optional monthly target used by PERCENT_OF_TARGET (centavos or count).
  targetValue Int              @default(0)
  metric      String           @default("revenue") // revenue | rating | attendance | bookings
  period      IncentivePeriod  @default(MONTHLY)
  active      Boolean          @default(true)
  note        String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  results IncentiveResult[]
}

model IncentiveResult {
  id             String          @id @default(cuid())
  schemeId       String
  scheme         IncentiveScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodKey      String // 2026-07 or 2026-Q3
  metricValue    Int             @default(0)
  suggestedCents Int             @default(0)
  note           String          @default("")
  computedAt     DateTime        @default(now())

  @@unique([schemeId, employeeId, periodKey])
}

// ============================================================ appointments

model Appointment {
  id         String            @id @default(cuid())
  branchId   String
  branch     Branch            @relation(fields: [branchId], references: [id])
  reference  String            @unique
  clientId   String
  client     Client            @relation(fields: [clientId], references: [id])
  resourceId String?
  resource   Resource?         @relation(fields: [resourceId], references: [id])
  partnerId  String?
  partner    Partner?          @relation(fields: [partnerId], references: [id])
  startAt    DateTime
  endAt      DateTime
  status     AppointmentStatus @default(PENDING)
  source     BookingSource     @default(PORTAL)
  notes      String            @default("")

  // --- reservation deposit (online bookings) ---
  depositStatus        DepositStatus @default(NONE)
  depositAmountCents   Int           @default(0)
  depositPaidCents     Int           @default(0)
  depositReference     String        @default("")
  depositProofUrl      String        @default("")
  depositMethod        String        @default("")
  gatewaySessionId     String        @default("")
  gatewayPaymentId     String        @default("")
  depositAppliedSaleId String?
  expiresAt            DateTime?

  // --- group booking ---
  /// Shared by every appointment made in one go, so a party of three is three
  /// bookings that were made together and are paid for together. Modelling a
  /// party as a single appointment holding several people would break capacity,
  /// conflict checking, therapist rotation and commission all at once — each of
  /// those is already per-person, and already correct.
  partyRef  String @default("")
  /// Who is on this bed, when it is not the person who booked. The booker stays
  /// the client of record: they pay, they earn the loyalty, and they are who we
  /// can contact. A guest is a name until they arrive and the desk takes their
  /// details properly.
  guestName String @default("")

  // --- after-hours request (a treatment that would run past closing) ---
  /// Set when the guest asked for a slot the spa cannot promise: the booking is
  /// a request, not a reservation, until someone at the desk says yes. No
  /// deposit is taken while this is true, so a declined request never has to be
  /// refunded.
  needsApproval Boolean   @default(false)
  approvedAt    DateTime?
  approvedBy    String    @default("")
  declineReason String    @default("")

  checkedInAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services AppointmentService[]
  sales    Sale[]

  @@index([branchId, startAt])
  @@index([partyRef])
  @@index([status, startAt])
  @@index([clientId])
}

/// One treatment inside a visit — a *segment*, with its own place and its own
/// clock.
///
/// A guest booking a sauna and a massage is one visit in two parts: half an
/// hour in the sauna, then an hour on a bed, with a gap between for the shower,
/// the consultation and the therapist to set up. Holding one place for the
/// whole visit would keep a bed empty through the sauna and sell neither.
model AppointmentService {
  id              String      @id @default(cuid())
  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service     @relation(fields: [serviceId], references: [id])
  employeeId      String?
  employee        Employee?   @relation(fields: [employeeId], references: [id])
  /// Where this treatment happens. The sauna for the sauna, a bed for the
  /// massage — the appointment's own `resourceId` is only the first one, kept
  /// so lists and receipts have something to name.
  resourceId      String?
  resource        Resource?   @relation(fields: [resourceId], references: [id])
  /// Snapshot of the list price at booking time (centavos).
  priceCents      Int
  durationMinutes Int
  /// Where it sits in the visit. Lower runs first.
  sortRank        Int         @default(0)

  /// The plan: when this treatment is scheduled to run.
  startAt           DateTime?
  endAt             DateTime?
  /// What actually happened, logged by the desk as the visit runs.
  ///
  /// A treatment that started late holds its place late, so occupancy is read
  /// from these when they are set and from the plan when they are not. Without
  /// them the calendar shows a bed free while somebody is still on it.
  actualStartAt     DateTime?
  actualEndAt       DateTime?
  /// Minutes to leave free *after* this treatment before the next one starts:
  /// the shower after a sauna, the foot soak and consultation before a massage.
  changeoverMinutes Int       @default(0)

  @@index([employeeId])
  @@index([resourceId, startAt])
}

// ============================================================ sales / POS

model ReceiptSeries {
  id           String  @id @default(cuid())
  branchId     String
  branch       Branch  @relation(fields: [branchId], references: [id])
  name         String  @default("Sales Invoice")
  prefix       String  @default("SI")
  /// BIR permit range. `next` never goes backwards and numbers are never reused.
  rangeStart   Int     @default(1)
  rangeEnd     Int     @default(999999)
  next         Int     @default(1)
  permitNumber String  @default("")
  active       Boolean @default(true)

  sales Sale[]

  @@unique([branchId, prefix])
}

model Sale {
  id        String        @id @default(cuid())
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id])
  seriesId  String
  series    ReceiptSeries @relation(fields: [seriesId], references: [id])
  /// Gapless, immutable, never reused. Voided numbers are retained.
  receiptNo String        @unique
  sequence  Int

  clientId               String?
  client                 Client?           @relation(fields: [clientId], references: [id])
  appointmentId          String?
  appointment            Appointment?      @relation(fields: [appointmentId], references: [id])
  corporateAccountId     String?
  corporateAccount       CorporateAccount? @relation(fields: [corporateAccountId], references: [id])
  partnerId              String?
  partner                Partner?          @relation(fields: [partnerId], references: [id])
  /// Set when the sale used the employee-rate discount.
  employeeRateEmployeeId String?
  employeeRateEmployee   Employee?         @relation("EmployeeRateSale", fields: [employeeRateEmployeeId], references: [id])

  cashierId String
  cashier   User   @relation("SaleCashier", fields: [cashierId], references: [id])

  subtotalCents      Int @default(0)
  discountCents      Int @default(0)
  depositCreditCents Int @default(0)
  tipCents           Int @default(0)
  totalCents         Int @default(0)
  paidCents          Int @default(0)
  changeCents        Int @default(0)
  cogsCents          Int @default(0)

  // --- tax fields: populated per the configured regime, present in both ---
  taxRegime           TaxRegime @default(NON_VAT_8)
  vatableSalesCents   Int       @default(0)
  vatExemptSalesCents Int       @default(0)
  zeroRatedSalesCents Int       @default(0)
  vatAmountCents      Int       @default(0)

  status           SaleStatus @default(PAID)
  voidReason       String     @default("")
  voidedAt         DateTime?
  voidedById       String?
  voidedBy         User?      @relation("SaleVoider", fields: [voidedById], references: [id])
  /// Void/refund replacement pointer (corrections are never hard deletes).
  replacedBySaleId String?

  businessDate DateTime @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines                SaleLine[]
  discounts            SaleDiscount[]
  payments             Payment[]
  commissions          Commission[]
  loyaltyTxns          LoyaltyTransaction[]
  journalEntries       JournalEntry[]
  giftCertificatesSold GiftCertificate[]           @relation("GcSoldOnSale")
  gcRedemptions        GiftCertificateRedemption[]
  voucherUses          VoucherRedemption[]
  clientPackages       ClientPackage[]

  @@index([branchId, businessDate])
  @@index([status])
  @@index([clientId])
}

model SaleLine {
  id             String       @id @default(cuid())
  saleId         String
  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  type           SaleLineType
  serviceId      String?
  service        Service?     @relation(fields: [serviceId], references: [id])
  itemId         String?
  item           Item?        @relation(fields: [itemId], references: [id])
  packageId      String?
  package        Package?     @relation(fields: [packageId], references: [id])
  employeeId     String?
  employee       Employee?    @relation(fields: [employeeId], references: [id])
  description    String
  quantity       Int          @default(1)
  /// Price actually charged (0 for perks / prepaid redemptions).
  unitPriceCents Int
  /// Undiscounted list price — commissions are always computed on this.
  basePriceCents Int
  lineTotalCents Int
  cogsCents      Int          @default(0)
  sortRank       Int          @default(0)

  commissions Commission[]

  @@index([saleId])
}

model SaleDiscount {
  id               String          @id @default(cuid())
  saleId           String
  sale             Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  presetId         String?
  preset           DiscountPreset? @relation(fields: [presetId], references: [id])
  label            String
  type             DiscountType
  value            Int
  amountCents      Int
  /// Order of application; each preset applies to the running total.
  sequence         Int             @default(0)
  /// PWD / Senior ID captured at checkout, printed on the receipt (BIR).
  idNumber         String          @default("")
  approvedByUserId String?
  voucherCode      String          @default("")
}

model DiscountPreset {
  id                String       @id @default(cuid())
  name              String
  type              DiscountType
  value             Int
  /// Empty array => applies to all services.
  serviceIds        String[]     @default([])
  stackable         Boolean      @default(true)
  active            Boolean      @default(true)
  requiresId        Boolean      @default(false)
  membersOnly       Boolean      @default(false)
  /// Employee-rate preset behaviour.
  isEmployeeRate    Boolean      @default(false)
  monthlyUsageLimit Int          @default(0)
  familyIncluded    Boolean      @default(false)
  sortRank          Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  saleDiscounts SaleDiscount[]
}

model Payment {
  id          String        @id @default(cuid())
  saleId      String
  sale        Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  amountCents Int
  reference   String        @default("")
  createdAt   DateTime      @default(now())

  @@index([saleId])
}

model Commission {
  id           String       @id @default(cuid())
  employeeId   String
  employee     Employee     @relation(fields: [employeeId], references: [id])
  saleId       String
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleLineId   String
  saleLine     SaleLine     @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  /// The undiscounted base the commission was computed on.
  basisCents   Int
  rateType     DiscountType
  rateValue    Int
  amountCents  Int
  businessDate DateTime     @db.Date
  payslipId    String?
  createdAt    DateTime     @default(now())

  @@index([employeeId, businessDate])
}

// ============================================================ loyalty, packages, vouchers

model LoyaltyTransaction {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  saleId    String?
  sale      Sale?    @relation(fields: [saleId], references: [id])
  points    Int
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model Package {
  id                    String      @id @default(cuid())
  name                  String
  type                  PackageType @default(SESSION_PACKAGE)
  description           String      @default("")
  priceCents            Int
  validityDays          Int         @default(365)
  /// MEMBERSHIP: percent discount granted to the member.
  memberDiscountPercent Int         @default(0)
  /// MEMBERSHIP: free birthday-month service perk.
  birthdayPerkServiceId String?
  active                Boolean     @default(true)
  showOnLanding         Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  items          PackageItem[]
  clientPackages ClientPackage[]
  saleLines      SaleLine[]
}

model PackageItem {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])
  sessions  Int     @default(1)

  @@unique([packageId, serviceId])
}

model ClientPackage {
  id                   String              @id @default(cuid())
  clientId             String
  client               Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  packageId            String
  package              Package             @relation(fields: [packageId], references: [id])
  saleId               String?
  sale                 Sale?               @relation(fields: [saleId], references: [id])
  purchasedAt          DateTime            @default(now())
  expiresAt            DateTime
  status               ClientPackageStatus @default(ACTIVE)
  /// Membership year in which the birthday perk was consumed (e.g. 2026).
  birthdayPerkUsedYear Int?
  expiryNotifiedAt     DateTime?

  entitlements ClientPackageEntitlement[]

  @@index([clientId, status])
  @@index([expiresAt])
}

model ClientPackageEntitlement {
  id              String        @id @default(cuid())
  clientPackageId String
  clientPackage   ClientPackage @relation(fields: [clientPackageId], references: [id], onDelete: Cascade)
  serviceId       String
  totalSessions   Int
  usedSessions    Int           @default(0)

  @@unique([clientPackageId, serviceId])
}

model GiftCertificate {
  id             String        @id @default(cuid())
  code           String        @unique
  faceValueCents Int
  balanceCents   Int
  /// Optional service-specific GC.
  serviceId      String?
  soldSaleId     String?
  soldSale       Sale?         @relation("GcSoldOnSale", fields: [soldSaleId], references: [id])
  buyerClientId  String?
  buyerClient    Client?       @relation(fields: [buyerClientId], references: [id])
  status         VoucherStatus @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())

  redemptions GiftCertificateRedemption[]
}

model GiftCertificateRedemption {
  id          String          @id @default(cuid())
  gcId        String
  gc          GiftCertificate @relation(fields: [gcId], references: [id], onDelete: Cascade)
  saleId      String
  sale        Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amountCents Int
  createdAt   DateTime        @default(now())
}

model VoucherBatch {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  vouchers  Voucher[]
}

model Voucher {
  id          String        @id @default(cuid())
  code        String        @unique
  batchId     String?
  batch       VoucherBatch? @relation(fields: [batchId], references: [id])
  type        DiscountType
  value       Int
  usesAllowed Int           @default(1)
  usesCount   Int           @default(0)
  expiresAt   DateTime?
  status      VoucherStatus @default(ACTIVE)
  note        String        @default("")
  createdAt   DateTime      @default(now())

  redemptions VoucherRedemption[]
}

model VoucherRedemption {
  id          String   @id @default(cuid())
  voucherId   String
  voucher     Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amountCents Int
  createdAt   DateTime @default(now())
}

model Promo {
  id            String       @id @default(cuid())
  name          String
  description   String       @default("")
  type          DiscountType
  value         Int
  startDate     DateTime
  endDate       DateTime
  serviceIds    String[]     @default([])
  code          String?
  active        Boolean      @default(true)
  showOnLanding Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ============================================================ inventory & purchasing

model ItemCategory {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
  items  Item[]
}

model Unit {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
  items  Item[]
}

model Item {
  id               String       @id @default(cuid())
  branchId         String
  branch           Branch       @relation(fields: [branchId], references: [id])
  name             String
  sku              String       @default("")
  categoryId       String
  category         ItemCategory @relation(fields: [categoryId], references: [id])
  unitId           String
  unit             Unit         @relation(fields: [unitId], references: [id])
  costCents        Int          @default(0)
  retailPriceCents Int          @default(0)
  sellable         Boolean      @default(false)
  stockQty         Float        @default(0)
  reorderLevel     Float        @default(0)
  supplierId       String?
  supplier         Supplier?    @relation(fields: [supplierId], references: [id])
  archived         Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  movements      StockMovement[]
  recipes        ServiceRecipe[]
  poLines        PurchaseOrderLine[]
  saleLines      SaleLine[]
  supplierItems  SupplierItem[]
  stockTakeLines StockTakeLine[]

  @@index([branchId, archived])
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String   @default("")
  mobile        String   @default("")
  email         String   @default("")
  address       String   @default("")
  paymentTerms  String   @default("")
  notes         String   @default("")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items          Item[]
  supplierItems  SupplierItem[]
  purchaseOrders PurchaseOrder[]
}

model SupplierItem {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  priceCents Int
  updatedAt  DateTime @updatedAt

  priceHistory SupplierPriceChange[]

  @@unique([supplierId, itemId])
}

model SupplierPriceChange {
  id             String       @id @default(cuid())
  supplierItemId String
  supplierItem   SupplierItem @relation(fields: [supplierItemId], references: [id], onDelete: Cascade)
  oldPriceCents  Int
  newPriceCents  Int
  changedAt      DateTime     @default(now())
  changedBy      String       @default("")
}

model StockMovement {
  id            String            @id @default(cuid())
  branchId      String
  branch        Branch            @relation(fields: [branchId], references: [id])
  itemId        String
  item          Item              @relation(fields: [itemId], references: [id])
  type          StockMovementType
  /// Signed: positive adds stock, negative removes it.
  quantity      Float
  unitCostCents Int               @default(0)
  reason        String            @default("")
  refType       String            @default("")
  refId         String            @default("")
  userId        String?
  userName      String            @default("")
  createdAt     DateTime          @default(now())

  @@index([itemId, createdAt])
  @@index([branchId, createdAt])
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  branchId   String
  branch     Branch              @relation(fields: [branchId], references: [id])
  number     String              @unique
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     PurchaseOrderStatus @default(DRAFT)
  totalCents Int                 @default(0)
  notes      String              @default("")
  createdBy  String              @default("")
  approvedBy String?
  approvedAt DateTime?
  receivedAt DateTime?
  expenseId  String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  lines PurchaseOrderLine[]

  @@index([branchId, status])
}

model PurchaseOrderLine {
  id            String        @id @default(cuid())
  poId          String
  po            PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item          @relation(fields: [itemId], references: [id])
  quantity      Float
  unitCostCents Int
  receivedQty   Float         @default(0)
}

model StockTake {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  takeDate  DateTime  @db.Date
  status    String    @default("OPEN") // OPEN | CLOSED
  notes     String    @default("")
  createdBy String    @default("")
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  lines StockTakeLine[]

  @@index([branchId, takeDate])
}

model StockTakeLine {
  id          String    @id @default(cuid())
  stockTakeId String
  stockTake   StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  systemQty   Float
  countedQty  Float     @default(0)
  varianceQty Float     @default(0)

  @@unique([stockTakeId, itemId])
}

// ============================================================ finance

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  active      Boolean   @default(true)
  /// Inventory purchases are capitalised on receipt and hit the P&L later as
  /// COGS when the stock is consumed — so they are excluded from operating
  /// expenses to avoid double-counting. They still appear in cash flow.
  capitalized Boolean   @default(false)
  /// Chart-of-accounts code this category posts to.
  accountCode String    @default("6900")
  expenses    Expense[]
}

model Expense {
  id            String          @id @default(cuid())
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id])
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  description   String
  amountCents   Int
  expenseDate   DateTime        @db.Date
  method        PaymentMethod   @default(CASH)
  receiptUrl    String          @default("")
  status        ExpenseStatus   @default(PENDING)
  submittedById String
  submittedBy   User            @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  approvedById  String?
  approvedBy    User?           @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  rejectReason  String          @default("")
  refType       String          @default("") // petty_cash | purchase_order | manual
  refId         String          @default("")
  voided        Boolean         @default(false)
  voidReason    String          @default("")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  journalEntries JournalEntry[]

  @@index([branchId, expenseDate])
  @@index([status])
}

model PettyCashTxn {
  id                String             @id @default(cuid())
  branchId          String
  branch            Branch             @relation(fields: [branchId], references: [id])
  direction         PettyCashDirection
  amountCents       Int
  categoryId        String?
  description       String
  receiptUrl        String             @default("")
  balanceAfterCents Int
  businessDate      DateTime           @db.Date
  recordedById      String
  recordedByName    String             @default("")
  expenseId         String?
  createdAt         DateTime           @default(now())

  @@index([branchId, businessDate])
}

model PettyCashRequest {
  id              String                 @id @default(cuid())
  branchId        String
  amountCents     Int
  reason          String                 @default("")
  status          PettyCashRequestStatus @default(PENDING)
  requestedById   String
  requestedByName String                 @default("")
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime               @default(now())
}

model EodClosing {
  id                     String   @id @default(cuid())
  branchId               String
  branch                 Branch   @relation(fields: [branchId], references: [id])
  businessDate           DateTime @db.Date
  /// { CASH: 1234, GCASH: 0, ... } in centavos
  expected               Json
  counted                Json
  expectedCashCents      Int      @default(0)
  countedCashCents       Int      @default(0)
  overShortCents         Int      @default(0)
  pettyCashExpectedCents Int      @default(0)
  pettyCashCountedCents  Int      @default(0)
  salesCount             Int      @default(0)
  grossSalesCents        Int      @default(0)
  notes                  String   @default("")
  closedById             String
  closedBy               User     @relation(fields: [closedById], references: [id])
  closedAt               DateTime @default(now())

  @@unique([branchId, businessDate])
}

/// Minimal chart of accounts so the system can emit real BIR-style journals.
model Account {
  id     String      @id @default(cuid())
  code   String      @unique
  name   String
  type   AccountType
  active Boolean     @default(true)

  lines JournalLine[]
}

model JournalEntry {
  id              String        @id @default(cuid())
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])
  source          JournalSource
  entryDate       DateTime      @db.Date
  reference       String        @default("")
  memo            String        @default("")
  saleId          String?
  sale            Sale?         @relation(fields: [saleId], references: [id])
  expenseId       String?
  expense         Expense?      @relation(fields: [expenseId], references: [id])
  /// Reversal pointer — corrections are posted, never deleted.
  reversesEntryId String?
  createdAt       DateTime      @default(now())
  createdBy       String        @default("")

  lines JournalLine[]

  @@index([branchId, entryDate])
  @@index([source, entryDate])
}

model JournalLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  debitCents  Int          @default(0)
  creditCents Int          @default(0)
  memo        String       @default("")
}

// ============================================================ comms & notifications

model Notification {
  id         String           @id @default(cuid())
  branchId   String?
  branch     Branch?          @relation(fields: [branchId], references: [id])
  /// Either targeted at one user, or at a role (userId null + role set).
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role?
  kind       NotificationKind
  title      String
  body       String           @default("")
  link       String           @default("")
  /// Stable key so the same condition doesn't create duplicates.
  dedupeKey  String           @unique
  readAt     DateTime?
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, resolvedAt])
  @@index([role, resolvedAt])
}

model Announcement {
  id        String   @id @default(cuid())
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  body      String
  pinned    Boolean  @default(true)
  createdAt DateTime @default(now())

  reads AnnouncementRead[]
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
}

model DirectMessage {
  id         String    @id @default(cuid())
  fromUserId String
  fromUser   User      @relation("MessageFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User      @relation("MessageTo", fields: [toUserId], references: [id], onDelete: Cascade)
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([toUserId, readAt])
  @@index([fromUserId, toUserId, createdAt])
}

model ShiftNote {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  noteDate      DateTime @db.Date
  body          String
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  appointmentId String?
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments ShiftNoteComment[]

  @@index([branchId, noteDate])
}

model ShiftNoteComment {
  id        String    @id @default(cuid())
  noteId    String
  note      ShiftNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime  @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String   @default("")
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  status    String   @default("sent") // sent | failed | logged
  error     String   @default("")
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([createdAt])
}

// ============================================================ compliance & KPIs

model Holiday {
  id   String      @id @default(cuid())
  date DateTime    @unique @db.Date
  name String
  type HolidayType @default(REGULAR)
}

model KpiTarget {
  id        String @id @default(cuid())
  /// YYYY-MM
  periodKey String
  key       String
  /// Money targets in centavos; ratios in whole percent; counts as-is.
  target    Int

  @@unique([periodKey, key])
}

model Permit {
  id             String     @id @default(cuid())
  kind           PermitKind @default(BUSINESS)
  name           String
  agency         String     @default("")
  refNumber      String     @default("")
  issueDate      DateTime?
  expiryDate     DateTime?
  fileUrl        String     @default("")
  notes          String     @default("")
  employeeId     String?
  employee       Employee?  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lastRemindedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([expiryDate])
}
