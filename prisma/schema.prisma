// ANICA Wellness Spa — Business Operating System
// -----------------------------------------------------------------------------
// Money is stored as INTEGER CENTAVOS everywhere (₱1.00 == 100).
// This keeps all arithmetic exact and makes P&L / payroll totals reproducible.
// Timestamps are stored in UTC; the app renders them in Asia/Manila.
// Every operational table carries `branchId` so multi-branch is live from day one.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Note: there is deliberately no `directUrl` here. Prisma treats a datasource
// env var as required at *schema validation* time, so declaring DIRECT_URL
// would break `prisma generate` on every host that does not need it. Instead
// scripts/build.mjs points DATABASE_URL at DIRECT_URL for the migration step
// only — see there for why a transaction pooler cannot run migrations.

// ============================================================ enums

