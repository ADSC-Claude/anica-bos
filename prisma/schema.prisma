  LOW_STOCK
  PETTY_CASH_REQUEST
  EXPENSE_APPROVAL
  EXPIRING_MEMBERSHIP
  CLIENT_FOLLOW_UP
  OVERDUE_CORPORATE
  ANNOUNCEMENT
  PERMIT_EXPIRY
  DISCOUNT_APPROVAL
  PURCHASE_ORDER
  DIRECT_MESSAGE
