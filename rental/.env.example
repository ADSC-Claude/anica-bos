# ---------------------------------------------------------------------------
# Short-term rental PMS — copy to `.env` and fill in. Never commit `.env`.
#
# Only DATABASE_URL and SESSION_SECRET are required. Everything else degrades
# to something usable, so a fresh clone runs the whole book → pay → confirm →
# clean → review chain with nothing but a database.
# ---------------------------------------------------------------------------

# Postgres used by the app at runtime.
# Supabase: the POOLED connection (port 6543, ...pooler.supabase.com).
DATABASE_URL="postgresql://stays:stays@127.0.0.1:5432/stays?schema=public"

# Direct connection, migrations only — a transaction pooler cannot run them.
# Supabase: the DIRECT or SESSION connection (port 5432).
DIRECT_URL="postgresql://stays:stays@127.0.0.1:5432/stays?schema=public"

# 32+ character random string used to sign session cookies.
#   openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public base URL. Used in emails, PayMongo redirects and iCal feed URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- PayMongo --------------------------------------------------------------
# Test keys start sk_test_, live keys sk_live_. Leave blank for SIMULATED mode:
# a local checkout page that posts through the real webhook handler.
#
# No publishable key: checkout sessions are created server-side, so nothing
# here ever runs in the browser and there is no key for the browser to hold.
PAYMONGO_SECRET_KEY=""
# Per webhook endpoint, shown once when you create it. Starts whsk_.
# Test and live endpoints have different secrets.
PAYMONGO_WEBHOOK_SECRET=""

# --- Email -----------------------------------------------------------------
# Blank RESEND_API_KEY logs mail to the console and records it as "logged".
RESEND_API_KEY=""
EMAIL_FROM="ANICA Stays <bookings@example.com>"

# --- File storage ----------------------------------------------------------
# Blank falls back to public/uploads on local disk (dev and CI).
# The service-role key is server-side only and must never reach a browser.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLIC_BUCKET="stays-public"
SUPABASE_PRIVATE_BUCKET="stays-private"

# --- Scheduled jobs --------------------------------------------------------
# Bearer secret for POST /api/jobs/minute and /api/jobs/daily.
CRON_SECRET="change-me-too"
