{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `rental/` is a separate application with its own tsconfig, its own Prisma
  // client and its own `@/*`. Without this exclusion the glob above swallows it
  // and resolves its imports against the spa's src/, which fails the spa's
  // typecheck and its Vercel build — for changes that never touched the spa.
  "exclude": ["node_modules", "rental"]
}
